<ContentDialog
    x:Class="CyberDownloadManager.Presentation.Views.AddDownloadDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="New Cyber Download Task"
    PrimaryButtonText="Start Download"
      SecondaryButtonText="Add to Queue"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
      SecondaryButtonClick="ContentDialog_SecondaryButtonClick"
    CornerRadius="12"
    Background="{ThemeResource CyberCardGlassBrush}">

    <StackPanel Spacing="16" Width="480" Margin="0,12,0,0">
        <!-- Target URL Input -->
        <TextBox x:Name="UrlTextBox"
                 Header="Target File URL or Video Link"
                 PlaceholderText="https://example.com/file.iso or YouTube/TikTok link..."
                 TextChanged="UrlTextBox_TextChanged"/>
        <TextBlock x:Name="ErrorText" Foreground="{ThemeResource CyberErrorBrush}" TextWrapping="Wrap" Visibility="Collapsed"/>

        <!-- Video Detection Banner (Hidden by default) -->
        <Border x:Name="VideoDetectedBanner" Visibility="Collapsed"
                Padding="12" Background="#1A00E5FF" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CyberPrimaryBrush}">
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE714;" FontSize="16" Foreground="{ThemeResource CyberPrimaryBrush}"/>
                    <TextBlock x:Name="VideoTitleText" Text="Video Detected!" FontWeight="Bold" Foreground="{ThemeResource CyberPrimaryBrush}"/>
                </StackPanel>
                <ComboBox x:Name="QualityComboBox" Header="Select Video Quality" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="2160p (4K)" Tag="2160p"/>
                    <ComboBoxItem Content="1080p (Full HD)" Tag="1080p" IsSelected="True"/>
                    <ComboBoxItem Content="720p (HD)" Tag="720p"/>
                    <ComboBoxItem Content="480p (SD)" Tag="480p"/>
                    <ComboBoxItem Content="360p (Low)" Tag="360p"/>
                </ComboBox>
                <TextBox x:Name="FileNameTextBox" Header="File name (without extension)"
                         PlaceholderText="Enter a name or use the video title"
                         TextChanged="FileNameTextBox_TextChanged"/>
            </StackPanel>
        </Border>

        <!-- Save Location Selection -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SavePathTextBox" Header="Save File Location" Margin="0,0,8,0"/>
            <Button Content="Browse..." VerticalAlignment="Bottom" Height="36" Grid.Column="1" Click="BrowseSavePath_Click"/>
        </Grid>

        <!-- Category and Threads Selection -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ComboBox x:Name="CategoryComboBox" Header="Category" SelectedIndex="0" HorizontalAlignment="Stretch" Margin="0,0,6,0">
                <ComboBoxItem Content="Software"/>
                <ComboBoxItem Content="Media and Video"/>
                <ComboBoxItem Content="Documents"/>
                <ComboBoxItem Content="Compressed Archives"/>
            </ComboBox>

            <ComboBox x:Name="ThreadsComboBox" Header="Multi-Thread Streams" SelectedIndex="2" HorizontalAlignment="Stretch" Margin="6,0,0,0" Grid.Column="1">
                <ComboBoxItem Content="4 Streams"/>
                <ComboBoxItem Content="8 Streams"/>
                <ComboBoxItem Content="16 Streams (Turbo)"/>
                <ComboBoxItem Content="32 Streams (Extreme)"/>
            </ComboBox>
        </Grid>

        <!-- Advanced Options Toggle -->
        <ToggleSwitch Header="Start Immediately upon Dialog Close" IsOn="True"/>
    </StackPanel>
</ContentDialog>
