<Page
    x:Class="CyberDownloadManager.Presentation.Views.AnalyticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28">
        <StackPanel Spacing="20">
            <!-- Header -->
            <StackPanel Spacing="4">
                <TextBlock Text="Network Analytics &amp; Bandwidth Performance" Style="{StaticResource TitleTextBlockStyle}" FontWeight="Bold" Foreground="{ThemeResource CyberPrimaryBrush}"/>
                <TextBlock Text="Historical transfer speeds, connection thread efficiency, and protocol distribution" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <!-- Speed Meter Visual Cards -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Margin="0,0,8,0" Padding="20" Background="{ThemeResource CyberCardGlassBrush}" CornerRadius="12" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="FREE STORAGE (C:)" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{Binding FreeStorageText}" Style="{StaticResource TitleTextBlockStyle}" FontWeight="Bold" Foreground="{ThemeResource CyberPrimaryBrush}"/>
                        <TextBlock Text="Available for Direct NVMe Downloads" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Margin="4,0,4,0" Padding="20" Background="{ThemeResource CyberCardGlassBrush}" CornerRadius="12" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="TOTAL DATA TRANSFERRED" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{Binding TotalTransferredText}" Style="{StaticResource TitleTextBlockStyle}" FontWeight="Bold" Foreground="{ThemeResource CyberSecondaryBrush}"/>
                        <TextBlock Text="{Binding TotalDownloadsText}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Margin="8,0,0,0" Padding="20" Background="{ThemeResource CyberCardGlassBrush}" CornerRadius="12" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="THREAD ACCELERATION" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="16 Multi-Streams" Style="{StaticResource TitleTextBlockStyle}" FontWeight="Bold" Foreground="{ThemeResource CyberSuccessBrush}"/>
                        <TextBlock Text="Parallel Range Requests Enabled" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Protocol Distribution & Performance Graphs -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Margin="0,0,10,0" Padding="20" Background="{ThemeResource CyberCardGlassBrush}" CornerRadius="12" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Category Distribution (not categorized yet)" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="SemiBold"/>
                        <StackPanel Spacing="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Media &amp; Videos"/>
                                <TextBlock Grid.Column="1" Text="N/A" FontWeight="Bold" Foreground="{ThemeResource CyberPrimaryBrush}"/>
                            </Grid>
                            <ProgressBar Value="0" Maximum="100" Height="6" CornerRadius="3" Foreground="{ThemeResource CyberPrimaryBrush}"/>

                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Software &amp; Executables"/>
                                <TextBlock Grid.Column="1" Text="N/A" FontWeight="Bold" Foreground="{ThemeResource CyberSecondaryBrush}"/>
                            </Grid>
                            <ProgressBar Value="0" Maximum="100" Height="6" CornerRadius="3" Foreground="{ThemeResource CyberSecondaryBrush}"/>

                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Documents &amp; Archives"/>
                                <TextBlock Grid.Column="1" Text="N/A" FontWeight="Bold" Foreground="{ThemeResource CyberSuccessBrush}"/>
                            </Grid>
                            <ProgressBar Value="0" Maximum="100" Height="6" CornerRadius="3" Foreground="{ThemeResource CyberSuccessBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Margin="10,0,0,0" Padding="20" Background="{ThemeResource CyberCardGlassBrush}" CornerRadius="12" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Engine Capabilities" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="SemiBold"/>
                        <StackPanel Spacing="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="HTTP/HTTPS parallel range downloads"/>
                                <TextBlock Grid.Column="1" Text="Available" FontWeight="Bold" Foreground="{ThemeResource CyberSuccessBrush}"/>
                            </Grid>
                            <ProgressBar Value="100" Maximum="100" Height="6" CornerRadius="3" Foreground="{ThemeResource CyberSuccessBrush}"/>

                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="yt-dlp video extraction"/>
                                <TextBlock Grid.Column="1" Text="Optional" FontWeight="Bold" Foreground="{ThemeResource CyberPrimaryBrush}"/>
                            </Grid>
                            <ProgressBar Value="100" Maximum="100" Height="6" CornerRadius="3" Foreground="{ThemeResource CyberPrimaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
