<Page
    x:Class="CyberDownloadManager.Presentation.Views.CompletedPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28">
        <StackPanel Spacing="20">

            <!-- Header -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Completed Downloads &amp; History" Style="{StaticResource TitleTextBlockStyle}" FontWeight="Bold" Foreground="{ThemeResource CyberSuccessBrush}"/>
                    <TextBlock Text="Archive of downloaded files, integrity hashes, and local storage paths" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <Button Grid.Column="1" Content="Clear History" VerticalAlignment="Center" IsEnabled="False"/>
            </Grid>

            <!-- Dynamic Completed List -->
            <ItemsControl ItemsSource="{Binding CompletedDownloads}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="18" Margin="0,0,0,12" Background="{ThemeResource CyberCardGlassBrush}" CornerRadius="12" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14">
                                    <Border Width="40" Height="40" CornerRadius="8" Background="#1A00E676">
                                        <FontIcon Glyph="&#xE73E;" FontSize="20" Foreground="{ThemeResource CyberSuccessBrush}"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{Binding FileName}" FontWeight="Bold" FontSize="14"/>
                                    <TextBlock Text="{Binding FilePath}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Content="Rename" Click="Rename_Click"/>
                                    <Button Content="Open Folder" Click="OpenFolder_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Empty State -->
            <Border x:Name="EmptyStatePanel" Padding="32" Background="{ThemeResource CyberCardGlassBrush}" CornerRadius="12" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <StackPanel Spacing="12" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE73E;" FontSize="36" Foreground="{ThemeResource CyberSuccessBrush}"/>
                    <TextBlock Text="No Completed Downloads Yet" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center"/>
                    <TextBlock Text="Finished downloads will be recorded here automatically." Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
