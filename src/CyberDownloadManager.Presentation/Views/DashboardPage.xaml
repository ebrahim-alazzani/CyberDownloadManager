<Page
    x:Class="CyberDownloadManager.Presentation.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28">
        <StackPanel Spacing="24">

            <!-- Top Header & Actions -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Cyber Command Hub" Style="{StaticResource TitleTextBlockStyle}" FontWeight="Bold" Foreground="{ThemeResource CyberPrimaryBrush}"/>
                    <TextBlock Text="Real-time multi-threaded transfer dashboard &amp; system status" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Button Click="BtnLogs_Click" ToolTipService.ToolTip="View Live Engine Logs &amp; Error Details">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE9D9;" FontSize="14" Foreground="{ThemeResource CyberPrimaryBrush}"/>
                            <TextBlock Text="Live Logs"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AccentButtonStyle}" Click="BtnAddTask_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="14"/>
                            <TextBlock Text="New Download"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Key Metric Glass Cards -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Margin="0,0,8,0" Padding="18" Background="{ThemeResource CyberCardGlassBrush}" CornerRadius="12" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <StackPanel Spacing="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="GLOBAL SPEED" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <FontIcon Grid.Column="1" Glyph="&#xE896;" FontSize="16" Foreground="{ThemeResource CyberPrimaryBrush}"/>
                        </Grid>
                        <TextBlock Text="{Binding GlobalSpeed}" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="Bold" Foreground="{ThemeResource CyberPrimaryBrush}"/>
                        <ProgressBar Value="0" Maximum="100" Height="4" CornerRadius="2" Foreground="{ThemeResource CyberProgressBarBrush}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Margin="4,0,4,0" Padding="18" Background="{ThemeResource CyberCardGlassBrush}" CornerRadius="12" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <StackPanel Spacing="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ACTIVE STREAMS" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <FontIcon Grid.Column="1" Glyph="&#xE8B9;" FontSize="16" Foreground="{ThemeResource CyberSecondaryBrush}"/>
                        </Grid>
                        <TextBlock Text="{Binding ActiveStreamsText}" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="Bold" Foreground="{ThemeResource CyberSecondaryBrush}"/>
                        <ProgressBar Value="0" Maximum="100" Height="4" CornerRadius="2" Foreground="{ThemeResource CyberSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Margin="4,0,4,0" Padding="18" Background="{ThemeResource CyberCardGlassBrush}" CornerRadius="12" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <StackPanel Spacing="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="COMPLETED TODAY" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <FontIcon Grid.Column="1" Glyph="&#xE73E;" FontSize="16" Foreground="{ThemeResource CyberSuccessBrush}"/>
                        </Grid>
                        <TextBlock Text="{Binding CompletedTodayText}" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="Bold" Foreground="{ThemeResource CyberSuccessBrush}"/>
                        <ProgressBar Value="0" Maximum="100" Height="4" CornerRadius="2" Foreground="{ThemeResource CyberSuccessBrush}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Margin="8,0,0,0" Padding="18" Background="{ThemeResource CyberCardGlassBrush}" CornerRadius="12" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <StackPanel Spacing="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="STORAGE REMAINING" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <FontIcon Grid.Column="1" Glyph="&#xE8B7;" FontSize="16" Foreground="{ThemeResource CyberWarningBrush}"/>
                        </Grid>
                        <TextBlock Text="{Binding StorageRemainingText}" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="Bold" Foreground="{ThemeResource CyberWarningBrush}"/>
                        <ProgressBar Value="0" Maximum="100" Height="4" CornerRadius="2" Foreground="{ThemeResource CyberWarningBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Active Streams Section -->
            <StackPanel Spacing="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Live Stream Acceleration" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="1" Text="{Binding ActiveStreamsText}" FontSize="12" Foreground="{ThemeResource CyberPrimaryBrush}" VerticalAlignment="Center"/>
                </Grid>

                <!-- Active Downloads List -->
                <ItemsControl ItemsSource="{Binding ActiveDownloads}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="18" Margin="0,0,0,12" Background="{ThemeResource CyberCardGlassBrush}" CornerRadius="12" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                <StackPanel Spacing="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                                            <Border Width="40" Height="40" CornerRadius="8" Background="#1A00E5FF">
                                                <FontIcon Glyph="&#xE8B9;" FontSize="20" Foreground="{ThemeResource CyberPrimaryBrush}"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{Binding FileName}" FontWeight="Bold" FontSize="14"/>
                                                <TextBlock Text="{Binding ProgressText}" FontSize="12" Foreground="{ThemeResource CyberPrimaryBrush}"/>
                                                <TextBlock Text="{Binding ErrorMessage}" FontSize="11" Foreground="{ThemeResource CyberErrorBrush}" TextWrapping="Wrap" MaxWidth="620"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StatusText}" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,8,0"/>
                                            <Button Content="Pause" Click="Pause_Click"/>
                                            <Button Content="Resume" Click="Resume_Click"/>
                                            <Button Content="Delete" Click="Delete_Click"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Progress Bar with percentage -->
                                    <ProgressBar Value="{Binding ProgressPercentage}" Maximum="100" Height="8" CornerRadius="4" Foreground="{ThemeResource CyberProgressBarBrush}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Empty State Message when no active downloads -->
                <Border Padding="32" Background="{ThemeResource CyberCardGlassBrush}" CornerRadius="12" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Visibility="{Binding EmptyStateVisibility}">
                    <StackPanel Spacing="12" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE896;" FontSize="36" Foreground="{ThemeResource CyberPrimaryBrush}"/>
                        <TextBlock Text="No Active Downloads" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center"/>
                        <TextBlock Text="Click 'New Download' above to paste a URL or YouTube link and start downloading." Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Quick Categories Grid -->
            <StackPanel Spacing="12">
                <TextBlock Text="Categories &amp; Vault" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="SemiBold"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Margin="0,0,6,0" Padding="14" Background="{ThemeResource CyberCardGlassBrush}" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE8B9;" FontSize="20" Foreground="{ThemeResource CyberPrimaryBrush}"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Software" FontWeight="SemiBold"/>
                                <TextBlock Text="Ready" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Margin="3,0,3,0" Padding="14" Background="{ThemeResource CyberCardGlassBrush}" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE8A5;" FontSize="20" Foreground="{ThemeResource CyberSecondaryBrush}"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Media and Video" FontWeight="SemiBold"/>
                                <TextBlock Text="Ready" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Margin="3,0,3,0" Padding="14" Background="{ThemeResource CyberCardGlassBrush}" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE8E5;" FontSize="20" Foreground="{ThemeResource CyberSuccessBrush}"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Documents" FontWeight="SemiBold"/>
                                <TextBlock Text="Ready" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Margin="6,0,0,0" Padding="14" Background="{ThemeResource CyberCardGlassBrush}" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE7B8;" FontSize="20" Foreground="{ThemeResource CyberWarningBrush}"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Archives (.zip)" FontWeight="SemiBold"/>
                                <TextBlock Text="Ready" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
