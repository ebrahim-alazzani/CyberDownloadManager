<ContentDialog
    x:Class="CyberDownloadManager.Presentation.Views.PlaylistDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="YouTube Playlist"
    PrimaryButtonText="Download Selected"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
    CornerRadius="12"
    Background="{ThemeResource CyberCardGlassBrush}">

    <StackPanel Spacing="16" Width="580" MinHeight="300">
        
        <!-- Loading State -->
        <StackPanel x:Name="LoadingPanel" Spacing="12" HorizontalAlignment="Center" Margin="0,40,0,40">
            <ProgressRing IsActive="True" Width="48" Height="48"/>
            <TextBlock Text="Loading playlist..." HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <!-- Playlist Content (hidden until loaded) -->
        <StackPanel x:Name="ContentPanel" Visibility="Collapsed" Spacing="12">
            
            <!-- Playlist Title -->
            <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon Glyph="&#xE93E;" FontSize="20" Foreground="{ThemeResource CyberPrimaryBrush}"/>
                <TextBlock x:Name="PlaylistTitleText" Text="Playlist" FontWeight="Bold" FontSize="16" 
                           Foreground="{ThemeResource CyberPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            
            <!-- Select All / Count -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button x:Name="BtnSelectAll" Content="Select All" Click="BtnSelectAll_Click"/>
                    <Button x:Name="BtnDeselectAll" Content="Deselect All" Click="BtnDeselectAll_Click"/>
                </StackPanel>
                <TextBlock x:Name="CountText" Grid.Column="1" Text="0 videos" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </Grid>
            
            <!-- Quality Selection -->
            <ComboBox x:Name="QualityComboBox" Header="Quality for All" SelectedIndex="1" HorizontalAlignment="Stretch">
                <ComboBoxItem Content="2160p (4K)" Tag="2160p"/>
                <ComboBoxItem Content="1080p (Full HD)" Tag="1080p"/>
                <ComboBoxItem Content="720p (HD)" Tag="720p"/>
                <ComboBoxItem Content="480p (SD)" Tag="480p"/>
            </ComboBox>

            <!-- Video List -->
            <ListView x:Name="VideoListView" MaxHeight="350" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="8,6" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" 
                                      Checked="CheckBox_Changed" Unchecked="CheckBox_Changed"/>
                            
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" 
                                           TextTrimming="CharacterEllipsis" MaxLines="1"/>
                            </StackPanel>
                            
                            <TextBlock Grid.Column="2" Text="{Binding DurationText}" VerticalAlignment="Center"
                                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>

        <!-- Error State -->
        <StackPanel x:Name="ErrorPanel" Visibility="Collapsed" Spacing="12" HorizontalAlignment="Center" Margin="0,40,0,40">
            <FontIcon Glyph="&#xE783;" FontSize="36" Foreground="{ThemeResource CyberWarningBrush}"/>
            <TextBlock Text="Failed to load playlist. Check URL and try again." 
                       HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
    </StackPanel>
</ContentDialog>
